{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QTest suite 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "suite_id", "protocol_version", "seed", "limits", "cases"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "suite_id": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"},
    "protocol_version": {"type": "string", "minLength": 1, "maxLength": 80},
    "description": {"type": "string", "maxLength": 4000},
    "seed": {"type": "integer", "minimum": 0, "maximum": 2147483647},
    "limits": {
      "type": "object", "additionalProperties": false,
      "required": ["max_jobs", "max_shots", "wall_seconds", "poll_seconds"],
      "properties": {
        "max_jobs": {"type": "integer", "minimum": 1, "maximum": 10000},
        "max_shots": {"type": "integer", "minimum": 1, "maximum": 1000000000},
        "wall_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 604800},
        "poll_seconds": {"type": "number", "minimum": 0.01, "maximum": 60}
      }
    },
    "cases": {
      "type": "array", "minItems": 1, "maxItems": 1000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "benchmark", "repetitions", "shots", "parameters"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"},
          "benchmark": {"type": "string", "minLength": 1, "maxLength": 120},
          "repetitions": {"type": "integer", "minimum": 1, "maximum": 100},
          "shots": {"type": "integer", "minimum": 1, "maximum": 1000000},
          "parameters": {"type": "object"}
        }
      }
    }
  }
}
